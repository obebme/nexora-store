DATABASE_URL=postgresql+psycopg://nexora:change-me@localhost:5432/nexora
JWT_SECRET=replace-with-a-long-random-secret
APP_NAME="NEXORA API"
ENVIRONMENT=development
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
UPLOADS_DIR=backend/uploads
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback
# SMTP sender settings; recipient addresses may use any email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
EMAIL_VERIFICATION_BASE_URL=http://localhost:8080
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8080/payment/return
ORDER_RESERVATION_MINUTES=30
# Keep disabled until the CDEK integration, delivery cost and legal checkout are verified.
SALES_ENABLED=false
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=change-this-local-db-password
